.filter-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.filter-item {
  display: inline-block;
  padding: 12rpx 20rpx 10rpx;
  margin-right: 12rpx;
  border-radius: 0;
  font-size: 26rpx;
  color: var(--text-2);
  background: transparent;
  border-bottom: 2rpx solid transparent;
}
.filter-active {
  background: transparent;
  color: var(--brand);
  border-bottom-color: var(--brand);
  font-weight: 600;
}
.contest-card {
  display: flex;
  flex-direction: column;
}
.contest-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.contest-desc {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
}
.contest-meta {
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}

/* 宽屏（≥600px）：赛事列表两列网格 */
@media (min-width: 600px) {
  .contest-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24rpx;
    align-items: start;
  }
  .contest-list .contest-card {
    margin-bottom: 0;
  }
}
