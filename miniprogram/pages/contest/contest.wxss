.page-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 4rpx 4rpx 28rpx;
}
.page-title {
  display: block;
  margin-top: 6rpx;
}
.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}
.count-badge {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  color: var(--brand);
  background: var(--brand-light);
}
.count-badge text:first-child {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 700;
}
.count-badge text:last-child {
  margin-top: 8rpx;
  font-size: 20rpx;
}
.filter-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.filter-item {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--card-2);
  border: 1rpx solid var(--border);
}
.filter-active {
  background: var(--brand-light);
  color: var(--brand);
  border-color: transparent;
  font-weight: 600;
}
.contest-card {
  display: flex;
  flex-direction: column;
}
.contest-card:active {
  border-color: var(--brand);
}
.contest-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.contest-desc {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
}
.contest-meta {
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}

/* 宽屏（≥600px）：赛事列表两列网格 */
@media (min-width: 600px) {
  .contest-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24rpx;
    align-items: start;
  }
  .contest-list .contest-card {
    margin-bottom: 0;
  }
}
