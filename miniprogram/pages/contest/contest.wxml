<view class="page readable">
  <view class="page-intro">
    <view>
      <text class="eyebrow">EESAST EVENTS</text>
      <text class="h1 page-title">赛事互动</text>
      <text class="text-2 page-subtitle">发现比赛，和队友一起把想法做出来。</text>
    </view>
    <view class="count-badge"><text>{{filteredContests.length}}</text><text>场赛事</text></view>
  </view>
  <!-- 筛选 -->
  <scroll-view class="filter-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-item {{filter === 'all' ? 'filter-active' : ''}}" bind:tap="setFilter" data-filter="all">全部</view>
    <view class="filter-item {{filter === 'ongoing' ? 'filter-active' : ''}}" bind:tap="setFilter" data-filter="ongoing">进行中</view>
    <view class="filter-item {{filter === 'not_started' ? 'filter-active' : ''}}" bind:tap="setFilter" data-filter="not_started">未开始</view>
    <view class="filter-item {{filter === 'finished' ? 'filter-active' : ''}}" bind:tap="setFilter" data-filter="finished">已结束</view>
  </scroll-view>

  <empty wx:if="{{loading}}" loading loading-text="加载赛事中…" />
  <block wx:else>
    <view wx:if="{{filteredContests.length === 0}}">
      <empty text="暂无赛事" />
    </view>
    <view class="contest-list">
      <view wx:for="{{filteredContests}}" wx:key="id" class="card contest-card" bind:tap="goDetail" data-id="{{item.id}}">
        <text class="contest-name">{{item.name}}</text>
        <text class="contest-desc ellipsis-2">{{item.description}}</text>
        <view class="row contest-meta">
          <text class="text-3">{{item.start}} ~ {{item.end}}</text>
          <text class="tag {{item.statusTag}}">{{item.statusText}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
