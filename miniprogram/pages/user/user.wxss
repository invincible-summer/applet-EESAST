.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 0 48rpx;
}
.login-logo {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  box-shadow: var(--shadow);
}
.login-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--text);
}
.login-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.login-card {
  padding: 40rpx 32rpx 32rpx;
}
.login-btn {
  margin-top: 4rpx;
}
.login-links {
  margin-top: 28rpx;
}
.login-tip {
  text-align: center;
  margin-top: 24rpx;
}

/* 输入框内嵌操作位（密码可见切换等） */
.input-wrap {
  position: relative;
}
.input-with-action {
  padding-right: 116rpx;
}
.input-action {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* 小屏（≤360px）：收紧登录页留白，避免键盘弹出后表单被顶出视口 */
@media (max-width: 360px) {
  .login-hero {
    padding: 40rpx 0 28rpx;
  }
  .login-logo {
    width: 112rpx;
    height: 112rpx;
    margin-bottom: 16rpx;
  }
  .login-title {
    font-size: 38rpx;
  }
  .login-card {
    padding: 28rpx 24rpx 24rpx;
  }
  .login-links {
    margin-top: 22rpx;
  }
}
.ph {
  color: var(--text-3);
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}
.avatar-placeholder {
  background: var(--brand-grad);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
}
.avatar-edit {
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  background: var(--card);
  border: 1rpx solid var(--border);
  color: var(--text-2);
  font-size: 18rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  color: var(--text-2);
  font-size: 26rpx;
}
.info-value {
  font-size: 26rpx;
  max-width: 60%;
  text-align: right;
  word-break: break-all;
}

.verify-card {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--brand);
}
.entry-arrow {
  font-size: 40rpx;
  color: var(--text-3);
  margin-left: 12rpx;
}

.action-card {
  padding: 0 28rpx;
}
.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.action-row:last-child {
  border-bottom: none;
}
.action-label {
  font-size: 28rpx;
}
.picker-value {
  color: var(--text);
}
