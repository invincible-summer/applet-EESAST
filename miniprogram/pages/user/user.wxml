<view class="page readable">

  <!-- ================= 登录视图 ================= -->
  <block wx:if="{{view === 'login'}}">
    <view class="login-hero">
      <image class="login-logo" src="/assets/logo.png" mode="aspectFit"></image>
      <text class="h1">EESAST</text>
      <text class="text-2">清华大学电子工程系学生科协</text>
    </view>

    <view class="card">
      <view class="form-item">
        <text class="form-label">用户名 / 邮箱</text>
        <input class="input" placeholder="请输入用户名或邮箱" value="{{loginForm.user}}"
          data-field="user" bind:input="onLoginInput" placeholder-class="ph" />
      </view>
      <view class="form-item">
        <text class="form-label">密码</text>
        <input class="input" placeholder="请输入密码" password value="{{loginForm.password}}"
          data-field="password" bind:input="onLoginInput" placeholder-class="ph" />
      </view>
      <view class="btn btn-primary {{logging ? 'btn-disabled' : ''}}" bind:tap="doLogin">
        {{logging ? "登录中…" : "登 录"}}
      </view>
      <view class="row-between" style="margin-top: 24rpx;">
        <text class="brand-text" bind:tap="goRegister">注册账号</text>
        <text class="text-3" bind:tap="goReset">忘记密码？</text>
      </view>
    </view>
    <view class="text-3 login-tip">提示：账号与 eesast.com 网页端一致；新用户请先注册。</view>
  </block>

  <!-- ================= 个人中心 ================= -->
  <block wx:elif="{{view === 'profile'}}">
    <view class="card profile-card">
      <view class="avatar-wrap" bind:tap="changeAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-placeholder">
          <text>{{profile.realname ? profile.realname[0] : (profile.username ? profile.username[0] : "客")}}</text>
        </view>
        <view class="avatar-edit">更换</view>
      </view>
      <view class="col flex-1">
        <view class="row">
          <text class="h2">{{profile.realname || profile.username || "用户"}}</text>
          <text class="tag tag-brand" style="margin-left: 14rpx;">{{roleText}}</text>
        </view>
        <text class="text-3" style="margin-top: 6rpx;">{{profile.email}}</text>
      </view>
    </view>

    <!-- 资料展示 -->
    <view class="card">
      <view class="row-between" style="margin-bottom: 12rpx;">
        <text class="h3">个人资料</text>
        <text class="brand-text" bind:tap="enterEdit">编辑</text>
      </view>
      <view class="info-row"><text class="info-label">用户名</text><text class="info-value">{{profile.username || "—"}}</text></view>
      <view class="info-row"><text class="info-label">姓名</text><text class="info-value">{{profile.realname || "—"}}</text></view>
      <view class="info-row"><text class="info-label">学号</text><text class="info-value">{{profile.student_no || "—"}}</text></view>
      <view class="info-row"><text class="info-label">院系</text><text class="info-value">{{profile.department || "—"}}</text></view>
      <view class="info-row"><text class="info-label">班级</text><text class="info-value">{{profile.class || "—"}}</text></view>
      <view class="info-row">
        <text class="info-label">清华邮箱</text>
        <text class="info-value {{profile.tsinghua_email ? '' : 'text-3'}}">{{profile.tsinghua_email || "未认证"}}</text>
      </view>
    </view>

    <!-- 认证提示 -->
    <view wx:if="{{user.role === 'user'}}" class="card verify-card" bind:tap="enterTsinghua">
      <view class="col flex-1">
        <text class="h3">完成清华邮箱认证</text>
        <text class="text-2" style="margin-top: 6rpx;">认证后可访问信息化平台（导师/奖学金等）</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <!-- LLM Token -->
    <view class="card" wx:if="{{llmToken}}">
      <view class="row-between">
        <view class="col flex-1">
          <text class="h3">AI 对话 Token</text>
          <text class="text-3 ellipsis" style="margin-top: 6rpx;">{{llmToken}}</text>
        </view>
        <view class="btn btn-sm btn-ghost" catch:tap="copyLlmToken">复制</view>
      </view>
    </view>

    <!-- 操作 -->
    <view class="card action-card">
      <view class="action-row" bind:tap="goReset">
        <text class="action-label">修改密码</text><text class="entry-arrow">›</text>
      </view>
      <view class="action-row danger" bind:tap="enterDelete">
        <text class="action-label" style="color: var(--danger);">注销账号</text><text class="entry-arrow">›</text>
      </view>
    </view>

    <view class="btn btn-plain" style="margin-top: 8rpx;" bind:tap="doLogout">退出登录</view>
  </block>

  <!-- ================= 编辑资料 ================= -->
  <block wx:elif="{{view === 'edit'}}">
    <view class="card">
      <view class="form-item">
        <text class="form-label">用户名</text>
        <input class="input" value="{{editForm.username}}" data-field="username" bind:input="onEditInput" placeholder-class="ph" />
      </view>
      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="input" value="{{editForm.realname}}" data-field="realname" bind:input="onEditInput" placeholder-class="ph" />
      </view>
      <view class="form-item">
        <text class="form-label">学号</text>
        <input class="input" value="{{editForm.student_no}}" data-field="student_no" bind:input="onEditInput" placeholder-class="ph" />
      </view>
      <view class="form-item">
        <text class="form-label">院系</text>
        <picker mode="selector" range="{{departments}}" value="{{deptIndex}}" bindchange="onDeptChange">
          <view class="input picker-value">{{editForm.department || "请选择院系"}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">班级</text>
        <picker mode="selector" range="{{classOptions}}" value="{{classIndex}}" bindchange="onClassChange">
          <view class="input picker-value">{{editForm.class || "请选择班级"}}</view>
        </picker>
      </view>
      <view class="row" style="gap: 20rpx;">
        <view class="btn btn-plain flex-1" bind:tap="backProfile">取消</view>
        <view class="btn btn-primary flex-1" bind:tap="saveProfile">保存</view>
      </view>
    </view>
  </block>

  <!-- ================= 清华认证 ================= -->
  <block wx:elif="{{view === 'tsinghua'}}">
    <view class="card">
      <text class="h2">清华邮箱认证</text>
      <text class="text-2" style="display:block; margin: 12rpx 0 28rpx;">认证后账号将升级为学生身份，可使用信息化平台功能。</text>
      <view class="form-item">
        <text class="form-label">清华邮箱</text>
        <input class="input" type="text" value="{{tsinghuaForm.email}}" data-field="email"
          bind:input="onTsinghuaInput" placeholder="xxx@tsinghua.edu.cn" placeholder-class="ph" />
      </view>
      <view class="form-item">
        <text class="form-label">验证码</text>
        <view class="row" style="gap: 16rpx;">
          <input class="input flex-1" type="number" maxlength="6" value="{{tsinghuaForm.code}}"
            data-field="code" bind:input="onTsinghuaInput" placeholder="6 位验证码" placeholder-class="ph" />
          <view class="btn btn-sm btn-ghost {{tsinghuaCountdown > 0 ? 'btn-disabled' : ''}}" bind:tap="sendTsinghuaCode">
            {{tsinghuaCountdown > 0 ? tsinghuaCountdown + "s" : "获取验证码"}}
          </view>
        </view>
      </view>
      <view class="btn btn-primary" bind:tap="submitTsinghua">提交认证</view>
      <view class="btn btn-plain" style="margin-top: 20rpx;" bind:tap="backProfile">返回</view>
    </view>
  </block>

  <!-- ================= 注销账号 ================= -->
  <block wx:elif="{{view === 'delete'}}">
    <view class="card">
      <text class="h2" style="color: var(--danger);">注销账号</text>
      <text class="text-2" style="display:block; margin: 12rpx 0 28rpx;">将向注册邮箱 {{profile.email}} 发送验证码，验证后删除账号全部数据，操作不可恢复。</text>
      <view class="form-item">
        <text class="form-label">验证码</text>
        <view class="row" style="gap: 16rpx;">
          <input class="input flex-1" type="number" maxlength="6" value="{{deleteForm.code}}"
            bind:input="onDeleteInput" placeholder="6 位验证码" placeholder-class="ph" />
          <view class="btn btn-sm btn-ghost {{deleteCountdown > 0 ? 'btn-disabled' : ''}}" bind:tap="sendDeleteCode">
            {{deleteCountdown > 0 ? deleteCountdown + "s" : "获取验证码"}}
          </view>
        </view>
      </view>
      <view class="btn btn-danger" bind:tap="confirmDelete">确认注销</view>
      <view class="btn btn-plain" style="margin-top: 20rpx;" bind:tap="backProfile">返回</view>
    </view>
  </block>
</view>
