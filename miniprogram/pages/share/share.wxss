.share-head {
  margin-bottom: 28rpx;
}
.share-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #c66a36, #eab049);
  font-size: 48rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(198, 106, 54, 0.2);
}
.entry-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.entry-card:active {
  border-color: var(--brand);
}
.entry-icon {
  font-size: 48rpx;
}
.entry-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.entry-desc {
  font-size: 24rpx;
  color: var(--text-2);
}
.entry-arrow {
  font-size: 40rpx;
  color: var(--text-3);
}
.tip {
  margin-top: 8rpx;
}
@media (min-width: 600px) {
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
  }
  .grid .entry-card {
    margin-bottom: 0;
  }
}
