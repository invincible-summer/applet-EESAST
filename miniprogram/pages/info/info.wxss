.gate {
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border-top: 6rpx solid var(--brand);
}
.gate-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.gate-desc {
  margin-bottom: 36rpx;
}
.gate-btn {
  width: 60%;
}

.entry-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx 24rpx;
}
.entry:active {
  background: var(--brand-light);
}
.entry-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}
.entry-label {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 600;
}

.info-intro {
  margin-bottom: 26rpx;
}
.intro-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: var(--brand-grad);
  font-size: 42rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(8, 91, 101, 0.2);
}

.type-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.type-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--card);
  border: 1rpx solid var(--border);
}
.type-active {
  background: var(--brand-light);
  color: var(--brand);
  border-color: transparent;
  font-weight: 600;
}

.notice-card {
  display: flex;
  flex-direction: column;
}
.notice-card:active {
  border-color: var(--brand);
}
.notice-title {
  font-size: 29rpx;
  font-weight: 600;
}
