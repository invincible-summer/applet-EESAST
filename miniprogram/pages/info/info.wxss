.gate {
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.gate-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.gate-desc {
  margin-bottom: 36rpx;
}
.gate-btn {
  width: 60%;
}

.entry-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
}
.entry-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}
.entry-label {
  font-size: 24rpx;
  color: var(--text-2);
}

.type-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.type-item {
  display: inline-block;
  padding: 12rpx 20rpx 10rpx;
  margin-right: 12rpx;
  border-radius: 0;
  font-size: 26rpx;
  color: var(--text-2);
  background: transparent;
  border-bottom: 2rpx solid transparent;
}
.type-active {
  background: transparent;
  color: var(--brand);
  border-bottom-color: var(--brand);
  font-weight: 600;
}

.notice-card {
  display: flex;
  flex-direction: column;
}
.notice-title {
  font-size: 29rpx;
  font-weight: 600;
}
