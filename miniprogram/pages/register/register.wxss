.steps {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 8rpx 32rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.step-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--card-2);
  border: 1rpx solid var(--border);
  color: var(--text-3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.step-on .step-dot {
  background: var(--brand-grad);
  color: #ffffff;
  border-color: transparent;
  font-weight: 700;
}
.step-label {
  font-size: 22rpx;
  color: var(--text-3);
  max-width: 100%;
  padding: 0 4rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}
.step-on .step-label {
  color: var(--brand);
}
/* 小屏（≤360px）：步骤条进一步收紧，保证 4 个标签不换行挤压 */
@media (max-width: 360px) {
  .steps {
    margin: 4rpx 0 24rpx;
  }
  .step-dot {
    width: 44rpx;
    height: 44rpx;
    font-size: 22rpx;
    margin-bottom: 6rpx;
  }
  .step-label {
    font-size: 20rpx;
  }
}
.role-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.role-item:last-child {
  border-bottom: none;
}
.role-disabled {
  opacity: 0.55;
}
.role-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.entry-arrow {
  font-size: 40rpx;
  color: var(--text-3);
  margin-left: 12rpx;
}
.ph {
  color: var(--text-3);
}
.picker-value {
  color: var(--text);
}
