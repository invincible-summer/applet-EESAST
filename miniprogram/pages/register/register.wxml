<view class="page readable">
  <!-- 进度 -->
  <view class="steps">
    <view wx:for="{{steps}}" wx:key="*this" class="step {{step >= index ? 'step-on' : ''}}">
      <view class="step-dot">{{index + 1}}</view>
      <text class="step-label">{{item}}</text>
    </view>
  </view>

  <!-- 步骤 0：身份 -->
  <view wx:if="{{step === 0}}" class="card">
    <text class="h3" style="margin-bottom: 24rpx; display:block;">选择注册身份</text>
    <view class="role-item" bind:tap="chooseRole" data-role="student">
      <view class="col flex-1">
        <text class="role-name">学生（清华在校生）</text>
        <text class="text-3">需清华学生邮箱 + 学号 + 班级，可使用全部功能</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="role-item" bind:tap="chooseRole" data-role="guest">
      <view class="col flex-1">
        <text class="role-name">访客</text>
        <text class="text-3">任意邮箱注册，可参与赛事</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="role-item role-disabled">
      <view class="col flex-1">
        <text class="role-name">教师</text>
        <text class="text-3">请联系管理员开通（management@eesast.com）</text>
      </view>
    </view>
  </view>

  <!-- 步骤 1：邮箱验证 -->
  <view wx:elif="{{step === 1}}" class="card">
    <view class="form-item">
      <text class="form-label">{{role === 'student' ? '清华学生邮箱' : '邮箱'}}</text>
      <input class="input" type="text" value="{{email}}" data-field="email" bind:input="onInput"
        placeholder="{{role === 'student' ? 'xxx@mails.tsinghua.edu.cn' : 'example@mail.com'}}" placeholder-class="ph" />
    </view>
    <view class="form-item">
      <text class="form-label">验证码</text>
      <view class="row" style="gap: 16rpx;">
        <input class="input flex-1" type="number" maxlength="6" value="{{code}}" data-field="code" bind:input="onInput" placeholder="6 位验证码" placeholder-class="ph" />
        <view class="btn btn-sm btn-ghost {{countdown > 0 ? 'btn-disabled' : ''}}" bind:tap="sendCode">
          {{countdown > 0 ? countdown + "s" : "获取验证码"}}
        </view>
      </view>
    </view>
    <view class="btn btn-primary" bind:tap="nextFromCode">下一步</view>
    <view class="btn btn-plain" style="margin-top: 20rpx;" bind:tap="prev">上一步</view>
  </view>

  <!-- 步骤 2：信息 -->
  <view wx:elif="{{step === 2}}" class="card">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="input" value="{{name}}" data-field="name" bind:input="onInput" placeholder="真实姓名" placeholder-class="ph" />
    </view>
    <view wx:if="{{role !== 'guest'}}" class="form-item">
      <text class="form-label">院系</text>
      <picker mode="selector" range="{{departments}}" value="{{departIndex}}" bindchange="onDepartChange">
        <view class="input picker-value">{{depart || "请选择院系"}}</view>
      </picker>
    </view>
    <block wx:if="{{role === 'student'}}">
      <view class="form-item">
        <text class="form-label">学号</text>
        <input class="input" type="number" maxlength="10" value="{{studentID}}" data-field="studentID" bind:input="onInput" placeholder="10 位学号" placeholder-class="ph" />
      </view>
      <view class="form-item">
        <text class="form-label">班级</text>
        <input class="input" value="{{class_}}" data-field="class_" bind:input="onInput" placeholder="如：无76" placeholder-class="ph" />
      </view>
    </block>
    <view class="btn btn-primary" bind:tap="nextFromInfo">下一步</view>
    <view class="btn btn-plain" style="margin-top: 20rpx;" bind:tap="prev">上一步</view>
  </view>

  <!-- 步骤 3：密码 -->
  <view wx:elif="{{step === 3}}" class="card">
    <view class="form-item">
      <text class="form-label">设置密码</text>
      <input class="input" password value="{{password}}" data-field="password" bind:input="onInput" placeholder="至少 8 位，含大小写字母和数字" placeholder-class="ph" />
    </view>
    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input class="input" password value="{{password2}}" data-field="password2" bind:input="onInput" placeholder="再次输入密码" placeholder-class="ph" />
    </view>
    <view class="btn btn-primary {{submitting ? 'btn-disabled' : ''}}" bind:tap="submit">
      {{submitting ? "提交中…" : "完成注册"}}
    </view>
    <view class="btn btn-plain" style="margin-top: 20rpx;" bind:tap="prev">上一步</view>
  </view>
</view>
