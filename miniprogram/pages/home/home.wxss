.news-swiper {
  height: 360rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--card);
  border: 1rpx solid var(--border);
}
.news-item {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  background: var(--card-2);
}
.news-img {
  width: 100%;
  height: 100%;
}
.news-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48%;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.58));
}
.news-title {
  position: absolute;
  left: 28rpx;
  bottom: 22rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  text-shadow: 0 0 12rpx rgba(0, 0, 0, 0.7);
}

.quick {
  display: flex;
  padding: 24rpx 12rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--brand);
  margin-bottom: 12rpx;
}
.qi-contest,
.qi-info,
.qi-course {
  background: var(--brand);
}
.quick-label {
  font-size: 24rpx;
  color: var(--text);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 4rpx 20rpx;
}
.section-head .text-3 {
  color: var(--text-2);
  letter-spacing: 1rpx;
}

.division-scroll {
  white-space: nowrap;
  display: flex;
}
.division-card {
  display: inline-flex;
  position: relative;
  width: 300rpx;
  height: 200rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: #ffffff;
  align-items: flex-end;
  background: var(--card);
  border: 1rpx solid var(--border);
}
.division-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.division-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.72));
}
.division-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  padding: 22rpx;
}
.division-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.division-desc {
  font-size: 20rpx;
  opacity: 0.92;
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.wall {
  display: flex;
  flex-direction: column;
}
.wall-card {
  padding: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.wall-img {
  width: 100%;
  height: 240rpx;
}
.wall-body {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}
.wall-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.wall-desc {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 18rpx;
}
.wall-actions {
  gap: 16rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 48rpx 0 24rpx;
}
.footer-links {
  margin-top: 8rpx;
  color: var(--brand);
}

@media (min-width: 600px) {
  .news-swiper,
  .news-item {
    height: 420rpx;
  }
  .wall {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24rpx;
  }
  .wall .wall-card {
    margin-bottom: 0;
  }
  .wall-img {
    height: 280rpx;
  }
}
