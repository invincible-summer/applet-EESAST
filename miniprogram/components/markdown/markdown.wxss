.md {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
  word-break: break-word;
}
.md-inline {
  display: block;
}
.md-h1 {
  font-size: 38rpx;
  font-weight: 700;
  margin: 24rpx 0 16rpx;
}
.md-h2 {
  font-size: 34rpx;
  font-weight: 700;
  margin: 22rpx 0 14rpx;
}
.md-h3 {
  font-size: 31rpx;
  font-weight: 600;
  margin: 20rpx 0 12rpx;
}
.md-h4 {
  font-size: 29rpx;
  font-weight: 600;
  margin: 18rpx 0 10rpx;
}
.md-p {
  margin: 12rpx 0;
}
.md-quote {
  margin: 16rpx 0;
  padding: 12rpx 24rpx;
  border-left: 6rpx solid var(--brand);
  background: var(--card-2);
  border-radius: 0 12rpx 12rpx 0;
  color: var(--text-2);
}
.md-list {
  margin: 12rpx 0;
}
.md-li {
  display: flex;
  padding: 6rpx 0;
}
.md-bullet {
  color: var(--brand);
  margin-right: 14rpx;
  flex-shrink: 0;
}
.md-olnum {
  min-width: 44rpx;
}
.md-codeblock {
  margin: 16rpx 0;
  background: var(--card-2);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  overflow: hidden;
}
.md-codeblock-head {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  border-bottom: 1rpx solid var(--border);
}
.md-code-lang {
  font-size: 22rpx;
  color: var(--text-3);
}
.md-code-copy {
  font-size: 22rpx;
  color: var(--brand);
}
.md-code-text {
  display: block;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  font-family: Menlo, Consolas, monospace;
  white-space: pre-wrap;
  color: var(--text);
}
.md-imgwrap {
  margin: 16rpx 0;
}
.md-blockimg {
  width: 100%;
  border-radius: 12rpx;
}
.md-hr {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}
.md-tablewrap {
  overflow-x: auto;
  margin: 16rpx 0;
}
.md-table {
  min-width: 100%;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  overflow: hidden;
}
.md-tr {
  display: flex;
  border-bottom: 1rpx solid var(--border);
}
.md-tr:last-child {
  border-bottom: none;
}
.md-thead {
  background: var(--card-2);
  font-weight: 600;
}
.md-td {
  flex: 1;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  min-width: 160rpx;
}
/* rich-text 内联样式（md-link / md-img / md-code 由 class 标记） */
.md .md-link {
  color: var(--brand);
}
