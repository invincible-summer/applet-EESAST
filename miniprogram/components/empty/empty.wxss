.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 40rpx;
}
.empty-dot {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: var(--brand-light);
  margin-bottom: 24rpx;
  position: relative;
}
.empty-dot::after {
  content: "";
  position: absolute;
  left: 27rpx;
  top: 27rpx;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid var(--brand);
  border-radius: 50%;
}
.empty-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid var(--border);
  border-top-color: var(--brand);
  animation: spin 0.9s linear infinite;
  margin: 16rpx 0 32rpx;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.empty-text {
  font-size: 26rpx;
  color: var(--text-3);
}
