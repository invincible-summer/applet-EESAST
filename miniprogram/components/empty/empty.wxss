.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}
.empty-dot {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-light);
  margin-bottom: 24rpx;
}
.empty-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid var(--border);
  border-top-color: var(--brand);
  animation: spin 0.9s linear infinite;
  margin: 16rpx 0 32rpx;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.empty-text {
  font-size: 26rpx;
  color: var(--text-3);
}
