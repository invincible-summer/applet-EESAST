page {
  height: 100%;
}
.chat-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}
.chat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--border);
}
.model-pick {
  padding: 10rpx 22rpx;
  background: var(--card-2);
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
}
.model-name {
  font-size: 26rpx;
  color: var(--brand);
  max-width: 320rpx;
  display: inline-block;
  vertical-align: middle;
}
.dt-toggle {
  font-size: 24rpx;
  color: var(--text-3);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.dt-on {
  color: var(--brand);
  border-color: var(--brand);
  background: var(--brand-light);
}
.drawer-btn {
  font-size: 34rpx;
  color: var(--text-2);
  padding: 0 10rpx;
}
.quota-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 24rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--border);
}
.quota-track {
  flex: 1;
  height: 8rpx;
  background: var(--border);
  border-radius: 999rpx;
  overflow: hidden;
}
.quota-fill {
  height: 100%;
  background: var(--brand);
  border-radius: 999rpx;
  transition: width 0.3s;
}
.quota-danger {
  background: var(--danger);
}
.msg-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.msg-row {
  display: flex;
  margin-bottom: 22rpx;
}
.msg-right {
  justify-content: flex-end;
}
.bubble {
  max-width: 82%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
.bubble-ai {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-top-left-radius: 4rpx;
  color: var(--text);
}
.bubble-user {
  background: var(--brand-grad);
  color: #ffffff;
  border-top-right-radius: 4rpx;
}
.bubble-text {
  word-break: break-all;
  white-space: pre-wrap;
}
.think-block {
  margin-bottom: 12rpx;
  border-bottom: 1rpx dashed var(--border);
  padding-bottom: 10rpx;
}
.think-head {
  display: flex;
  justify-content: space-between;
}
.think-title {
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 600;
}
.think-arrow {
  font-size: 22rpx;
  color: var(--brand);
}
.think-body {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 10rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.chat-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--border);
}
.send-btn {
  padding: 0 34rpx;
  height: 76rpx;
  border-radius: 14rpx;
  background: var(--brand-grad);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.send-stop {
  background: var(--danger);
}
.drawer-mask {
  position: fixed;
  inset: 0;
  background: var(--mask);
  z-index: 100;
}
.drawer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 72%;
  max-width: 560rpx;
  background: var(--card);
  display: flex;
  flex-direction: column;
  animation: slideIn 0.2s ease;
}
@keyframes slideIn {
  from {
    transform: translateX(100%);
  }
  to {
    transform: translateX(0);
  }
}
.drawer-list {
  flex: 1;
}
.drawer-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  gap: 14rpx;
}
.drawer-on {
  background: var(--brand-light);
}
.drawer-title {
  font-size: 27rpx;
}
.drawer-del {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
.ph {
  color: var(--text-3);
}
