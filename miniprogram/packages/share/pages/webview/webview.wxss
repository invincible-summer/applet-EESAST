.webview-fallback {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: var(--bg);
  text-align: center;
}
.fallback-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.fallback-desc {
  margin-top: 14rpx;
}
.fallback-btn {
  width: 320rpx;
  margin-top: 34rpx;
}

