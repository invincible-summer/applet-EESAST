<view class="page readable">
  <empty wx:if="{{loading}}" loading loading-text="加载中…" />

  <block wx:elif="{{course}}">
    <!-- 课程信息 -->
    <view class="card">
      <view class="row-between">
        <text class="h2">{{course.name}}</text>
        <text class="tag tag-gray">{{course.type}}</text>
      </view>
      <text class="text-2" style="display:block; margin-top: 8rpx;">{{course.fullname}}</text>
      <view class="row wrap" style="gap: 12rpx; margin-top: 16rpx;">
        <text class="tag tag-brand">{{course.professor || '未知教师'}}</text>
        <text class="tag tag-gray">{{course.code}}</text>
        <text class="tag tag-gray">{{course.semester}} {{course.year}}</text>
        <text class="tag tag-gray">{{course.language}}</text>
      </view>
    </view>

    <!-- Tabs -->
    <view class="tab-bar">
      <view class="tab-item {{tab === 'rating' ? 'tab-on' : ''}}" bind:tap="setTab" data-tab="rating">评分（{{ratingCount}}）</view>
      <view class="tab-item {{tab === 'comments' ? 'tab-on' : ''}}" bind:tap="setTab" data-tab="comments">评论（{{comments.length}}）</view>
    </view>

    <!-- 评分 -->
    <block wx:if="{{tab === 'rating'}}">
      <view class="card">
        <text class="h3" style="display:block; margin-bottom: 6rpx;">同学评分</text>
        <text class="text-3" style="display:block; margin-bottom: 20rpx;">星级越高：任务量越小、难度越低、质量/收获/给分越好</text>
        <view wx:for="{{dims}}" wx:key="key" class="dim-row">
          <text class="dim-label">{{item.label}}</text>
          <view class="col flex-1">
            <view class="row-between">
              <text class="text-3">均分 {{item.avg === null ? '—' : item.avg}}</text>
              <text class="brand-text">我的：{{item.value || '未评'}}</text>
            </view>
            <slider min="0" max="10" step="1" value="{{item.value}}" activeColor="#4f46e5"
              block-size="20" data-index="{{index}}" bind:change="onRateChange" disabled="{{!myRating && !item.value && false}}" />
          </view>
        </view>
        <view class="row" style="gap: 18rpx; margin-top: 12rpx;">
          <view wx:if="{{myRating}}" class="btn btn-plain flex-1" bind:tap="deleteRating">删除我的评分</view>
          <view class="btn btn-primary flex-1" bind:tap="saveRating">{{myRating ? '更新评分' : '提交评分'}}</view>
        </view>
      </view>
    </block>

    <!-- 评论 -->
    <block wx:if="{{tab === 'comments'}}">
      <!-- 输入区 -->
      <view class="card">
        <text class="h3" style="display:block; margin-bottom: 16rpx;">{{editingComment ? '编辑评论' : (replyTo ? '回复 ' + replyTo.username : '发表评论')}}</text>
        <textarea class="textarea" value="{{commentInput}}" bind:input="onCommentInput"
          placeholder="分享你的课程体验…" placeholder-class="ph" maxlength="500"></textarea>
        <view class="row" style="gap: 18rpx; margin-top: 18rpx;">
          <view wx:if="{{editingComment || replyTo}}" class="btn btn-plain flex-1" bind:tap="cancelEdit">取消</view>
          <view class="btn btn-primary flex-1" bind:tap="submitComment">{{editingComment ? '保存' : '发布'}}</view>
        </view>
      </view>

      <empty wx:if="{{comments.length === 0}}" text="暂无评论，来抢沙发" />
      <view wx:for="{{comments}}" wx:key="uuid" class="card comment-card">
        <view class="row-between">
          <view class="row" style="gap: 14rpx;">
            <view class="comment-avatar">{{item.username[0]}}</view>
            <view class="col">
              <text class="bold">{{item.username}}</text>
              <text class="text-3">{{item.time}}</text>
            </view>
          </view>
        </view>
        <text class="comment-text" user-select>{{item.comment}}</text>
        <view class="row-between" style="margin-top: 14rpx;">
          <view class="row" style="gap: 30rpx;">
            <text class="act {{item.liked ? 'brand-text' : 'text-3'}}" bind:tap="toggleLike" data-uuid="{{item.uuid}}">👍 {{item.likes}}</text>
            <text class="act {{item.stared ? 'brand-text' : 'text-3'}}" bind:tap="toggleStar" data-uuid="{{item.uuid}}">⭐ {{item.stars}}</text>
          </view>
          <view wx:if="{{item.mine}}" class="row" style="gap: 24rpx;">
            <text class="brand-text act" bind:tap="editComment" data-uuid="{{item.uuid}}">编辑</text>
            <text class="act" style="color: var(--danger);" bind:tap="deleteComment" data-uuid="{{item.uuid}}">删除</text>
          </view>
        </view>
      </view>
    </block>
  </block>
  <empty wx:else text="课程不存在" />
</view>
