.tab-bar {
  display: flex;
  background: var(--card);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-2);
  border-radius: 12rpx;
}
.tab-on {
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 600;
}
.dim-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
}
.dim-label {
  width: 210rpx;
  font-size: 26rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.comment-card {
  display: flex;
  flex-direction: column;
}
.comment-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--brand-grad);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.comment-text {
  display: block;
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.7;
  word-break: break-all;
}
.act {
  font-size: 24rpx;
}
.ph {
  color: var(--text-3);
}
