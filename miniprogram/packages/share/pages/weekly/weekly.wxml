<view class="page readable">
  <empty wx:if="{{loading}}" loading loading-text="加载中…" />
  <block wx:else>
    <empty wx:if="{{weeklies.length === 0}}" text="暂无推送" />
    <view wx:for="{{weeklies}}" wx:key="id" class="card weekly-card" bind:tap="openWeekly" data-id="{{item.id}}" data-url="{{item.url}}">
      <view class="col flex-1">
        <text class="weekly-title ellipsis-2">{{item.title}}</text>
        <text class="text-3" style="margin-top: 10rpx;">{{item.date}}</text>
      </view>
      <text class="weekly-action">{{item.canOpenInApp ? '阅读' : '复制'}}</text>
    </view>
    <view class="text-3" style="text-align:center; margin-top: 16rpx;">公众号文章将在小程序内打开，其他链接将复制到剪贴板</view>
  </block>
</view>
