.ph {
  color: var(--text-3);
}
.room-card {
  display: flex;
  flex-direction: column;
}
.vs-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0 20rpx;
}
.vs-team {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}
.vs-name {
  font-size: 27rpx;
  font-weight: 600;
  max-width: 100%;
}
.vs-score {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand);
  margin-top: 6rpx;
}
.vs-text {
  color: var(--text-3);
  font-size: 24rpx;
  padding: 0 20rpx;
}
.room-actions {
  gap: 16rpx;
  justify-content: flex-end;
}
.refresh-tip {
  text-align: center;
  margin-top: 16rpx;
}
