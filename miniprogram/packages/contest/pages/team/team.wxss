.ph {
  color: var(--text-3);
}
.invite-result {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--card-2);
}
.code-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
  letter-spacing: 6rpx;
}
.stat-row {
  display: flex;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand);
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
  gap: 18rpx;
}
.member-item:last-child {
  border-bottom: none;
}
.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-grad);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.member-name {
  font-size: 28rpx;
  font-weight: 600;
}
.member-remove {
  color: var(--danger);
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--danger);
  border-radius: 999rpx;
}
