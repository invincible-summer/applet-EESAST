<view class="page readable">
  <empty wx:if="{{loading}}" loading loading-text="加载中…" />

  <view wx:elif="{{access === 'forbidden'}}" class="card gate">
    <text class="h3">需要清华学生身份</text>
    <text class="text-2" style="display:block; margin-top: 10rpx;">请在「我的」页完成清华邮箱认证后使用。</text>
  </view>

  <block wx:else>
    <!-- Tabs -->
    <view class="tab-bar">
      <view class="tab-item {{tab === 'apply' ? 'tab-on' : ''}}" bind:tap="setTab" data-tab="apply">我的申请</view>
      <view class="tab-item {{tab === 'mentors' ? 'tab-on' : ''}}" bind:tap="setTab" data-tab="mentors">导师列表</view>
      <view class="tab-item {{tab === 'talk' ? 'tab-on' : ''}}" bind:tap="setTab" data-tab="talk">谈话记录</view>
    </view>

    <!-- 时间表（常显） -->
    <view class="card" wx:if="{{tab === 'apply'}}">
      <text class="h3" style="display:block; margin-bottom: 16rpx;">申请时间表</text>
      <view wx:for="{{schedule}}" wx:key="key" class="sched-row">
        <text class="sched-key">{{item.key}}</text>
        <view class="col flex-1">
          <text class="bold">{{item.name}}</text>
          <text class="text-3">{{item.beg}} ~ {{item.end}}</text>
        </view>
      </view>
      <view class="row-between" style="margin-top: 20rpx;">
        <text class="text-3">已与导师配对？</text>
        <view class="btn btn-sm btn-ghost" bind:tap="goChat">进入导师交流</view>
      </view>
    </view>

    <!-- 我的申请 -->
    <block wx:if="{{tab === 'apply'}}">
      <empty wx:if="{{applications.length === 0}}" text="暂无申请，去「导师列表」提交申请" />
      <view wx:for="{{applications}}" wx:key="id" class="card">
        <view class="row-between">
          <view class="col">
            <text class="bold">{{item.mentorName}}</text>
            <text class="text-3">{{item.mentorDept}}</text>
          </view>
          <text class="tag {{item.status === 'approved' ? 'tag-success' : item.status === 'rejected' ? 'tag-danger' : 'tag-warning'}}">{{item.statusText}}</text>
        </view>
        <text class="text-2 appl-stmt">{{item.stmt}}</text>
        <view class="row" style="gap: 20rpx; margin-top: 14rpx;" wx:if="{{item.status !== 'approved'}}">
          <text class="brand-text" bind:tap="deleteApply" data-id="{{item.id}}">撤销申请</text>
        </view>
      </view>
    </block>

    <!-- 导师列表 -->
    <block wx:if="{{tab === 'mentors'}}">
      <view wx:for="{{mentors}}" wx:key="uuid" class="card">
        <view class="row-between">
          <view class="row" style="gap: 12rpx;">
            <text class="bold" style="font-size: 30rpx;">{{item.name}}</text>
            <text wx:if="{{item.isMem}}" class="tag tag-brand">积极分子导师</text>
          </view>
          <text class="tag {{item.avail ? 'tag-success' : 'tag-gray'}}">{{item.avail ? '可申请' : '已满'}}</text>
        </view>
        <text class="text-3" style="display:block; margin-top: 6rpx;">{{item.dept}} · {{item.matApl || 0}}/{{item.maxApl || 0}} 已匹配</text>
        <view wx:if="{{item.bgnd}}" class="mt-field">
          <text class="field-label">背景</text>
          <text class="field-value">{{item.bgnd}}</text>
        </view>
        <view wx:if="{{item.flds}}" class="mt-field">
          <text class="field-label">领域</text>
          <text class="field-value">{{item.flds}}</text>
        </view>
        <view wx:if="{{item.achv}}" class="mt-field">
          <text class="field-label">成就</text>
          <text class="field-value">{{item.achv}}</text>
        </view>
        <view class="btn btn-sm btn-primary" style="margin-top: 18rpx; align-self: flex-start;" bind:tap="openApply" data-uuid="{{item.uuid}}">
          申请该导师
        </view>
      </view>
    </block>

    <!-- 谈话记录 -->
    <block wx:if="{{tab === 'talk'}}">
      <view class="card">
        <view class="row-between" style="margin-bottom: 12rpx;">
          <text class="h3">导师谈话记录</text>
          <view class="btn btn-sm btn-primary" bind:tap="uploadRecord" data-kind="talk">上传记录</view>
        </view>
        <empty wx:if="{{talk.records.length === 0}}" text="暂无记录" />
        <view wx:for="{{talk.records}}" wx:key="id" class="record-row">
          <view class="col flex-1">
            <text class="bold">{{item.semester || '旧系统'}}</text>
            <text class="text-3">{{item.updated}}</text>
          </view>
          <text class="tag {{item.confirmed ? 'tag-success' : 'tag-warning'}}">{{item.confirmed ? '已确认' : '待确认'}}</text>
          <text class="brand-text" style="margin-left: 20rpx;" bind:tap="downloadRecord" data-kind="talk" data-semester="{{item.semester}}" data-id="{{item.id}}">下载</text>
        </view>
      </view>

      <view class="card">
        <view class="row-between" style="margin-bottom: 12rpx;">
          <text class="h3">积极分子谈话记录</text>
          <view class="btn btn-sm btn-primary" bind:tap="uploadRecord" data-kind="member">上传记录</view>
        </view>
        <empty wx:if="{{memberChat.records.length === 0}}" text="暂无记录" />
        <view wx:for="{{memberChat.records}}" wx:key="id" class="record-row">
          <view class="col flex-1">
            <text class="bold">{{item.semester || '旧系统'}}</text>
            <text class="text-3">{{item.updated}}</text>
          </view>
          <text class="tag {{item.confirmed ? 'tag-success' : 'tag-warning'}}">{{item.confirmed ? '已确认' : '待确认'}}</text>
          <text class="brand-text" style="margin-left: 20rpx;" bind:tap="downloadRecord" data-kind="member" data-semester="{{item.semester}}" data-id="{{item.id}}">下载</text>
        </view>
      </view>
    </block>
  </block>

  <!-- 申请弹层 -->
  <view wx:if="{{applying}}" class="modal-mask" bind:tap="closeApply">
    <view class="modal card" catch:tap="">
      <text class="h3">{{curApplication ? '修改申请' : '新申请'}} · {{applyMentor.name}}</text>
      <text class="text-3" style="display:block; margin: 6rpx 0 20rpx;">{{applyMentor.dept}}</text>

      <block wx:if="{{!curApplication && applyMentor.isMem && applyIsMemberChoice}}">
        <view class="row-between member-row">
          <text class="text">是否作为积极分子谈话</text>
          <switch checked="{{applyIsMember}}" bindchange="onMemberToggle" color="#4f46e5" />
        </view>
      </block>

      <textarea class="textarea" value="{{applyStmt}}" bind:input="onStmtInput"
        placeholder="写一段自我介绍与申请理由…" placeholder-class="ph" maxlength="500"></textarea>

      <view class="row" style="gap: 18rpx; margin-top: 24rpx;">
        <view class="btn btn-plain flex-1" bind:tap="closeApply">取消</view>
        <view class="btn btn-primary flex-1" bind:tap="submitApply">提交</view>
      </view>
    </view>
  </view>
</view>
