.gate {
  text-align: center;
  padding: 60rpx 40rpx;
}
.appl-stmt {
  display: block;
  margin-top: 12rpx;
  padding: 16rpx;
  background: var(--card-2);
  border-radius: 12rpx;
  font-size: 25rpx;
  color: var(--text-2);
}
.appl-actions {
  gap: 28rpx;
  margin-top: 14rpx;
}
.danger-text {
  color: var(--danger);
}
.modal-mask {
  position: fixed;
  inset: 0;
  background: var(--mask);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.modal {
  width: 100%;
  max-width: 640rpx;
  margin: 0;
  max-height: 80vh;
  overflow-y: auto;
}
.upload-file {
  font-size: 25rpx;
  color: var(--text-2);
  background: var(--card-2);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}
.picker-value {
  color: var(--text);
}
.ph {
  color: var(--text-3);
}
