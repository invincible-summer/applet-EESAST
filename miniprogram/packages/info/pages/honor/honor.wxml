<view class="page readable">
  <empty wx:if="{{loading}}" loading loading-text="加载中…" />

  <view wx:elif="{{access === 'forbidden'}}" class="card gate">
    <text class="h3">需要清华学生身份</text>
    <text class="text-2" style="display:block; margin-top: 10rpx;">奖学金申请仅面向已认证学生开放。</text>
  </view>

  <block wx:else>
    <!-- 时间表 -->
    <view class="card">
      <view class="row-between" style="margin-bottom: 12rpx;">
        <text class="h3">{{year}} 年度荣誉申请</text>
        <text class="tag {{phase === 'closed' ? 'tag-gray' : 'tag-success'}}">
          {{phase === 'open-a' ? '阶段一进行中' : phase === 'open-b' ? '补交阶段' : '未开放'}}
        </text>
      </view>
      <text class="text-3">{{timeText}}</text>
    </view>

    <!-- 申请列表 -->
    <view class="row-between" style="margin: 8rpx 4rpx 20rpx;">
      <text class="h3">我的申请（{{applications.length}}）</text>
      <view class="btn btn-sm btn-primary" bind:tap="openCreate">新建申请</view>
    </view>
    <empty wx:if="{{applications.length === 0}}" text="暂无申请" />
    <view wx:for="{{applications}}" wx:key="id" class="card">
      <view class="row-between">
        <text class="h3">{{item.honor}}</text>
        <text class="tag {{item.status === 'approved' ? 'tag-success' : item.status === 'rejected' ? 'tag-danger' : 'tag-warning'}}">{{item.statusText}}</text>
      </view>
      <text class="text-3" style="display:block; margin-top: 6rpx;">更新于 {{item.updated}}</text>
      <text class="appl-stmt">{{item.statement}}</text>
      <view class="row appl-actions">
        <text wx:if="{{item.status !== 'approved'}}" class="brand-text" bind:tap="openEdit" data-id="{{item.id}}">修改</text>
        <text wx:if="{{item.status !== 'approved'}}" class="danger-text" bind:tap="deleteApplication" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </block>

  <!-- 申请表单弹层 -->
  <view wx:if="{{formVisible}}" class="modal-mask" bind:tap="closeForm">
    <view class="modal card" catch:tap="">
      <text class="h3">{{editing ? '修改申请' : '新建申请'}}</text>

      <view class="form-item" style="margin-top: 22rpx;">
        <text class="form-label">荣誉类型</text>
        <picker mode="selector" range="{{honorOptions}}" value="{{honorIndex}}" bindchange="onHonorChange">
          <view class="input picker-value">{{form.honor || "请选择荣誉"}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">申请陈述</text>
        <textarea class="textarea" value="{{form.statement}}" data-field="statement" bind:input="onFormInput"
          placeholder="请陈述申请理由…" placeholder-class="ph" maxlength="1000"></textarea>
      </view>

      <view class="form-item" wx:if="{{needMaterialLink}}">
        <text class="form-label">材料链接（云盘/仓库）</text>
        <input class="input" value="{{form.attachment_url}}" data-field="attachment_url" bind:input="onFormInput"
          placeholder="https://…" placeholder-class="ph" />
      </view>

      <view class="form-item" wx:if="{{needApplicationForm}}">
        <text class="form-label">申请表（必传）</text>
        <view class="row" style="gap: 16rpx;">
          <text class="upload-file ellipsis flex-1">{{form.application_form_url ? form.application_form_url.split('/').pop() : '未上传'}}</text>
          <view class="btn btn-sm btn-ghost" bind:tap="uploadFile" data-kind="application_form">上传</view>
        </view>
      </view>

      <view class="form-item" wx:if="{{needTranscript}}">
        <text class="form-label">成绩单（必传）</text>
        <view class="row" style="gap: 16rpx;">
          <text class="upload-file ellipsis flex-1">{{form.transcript_url ? form.transcript_url.split('/').pop() : '未上传'}}</text>
          <view class="btn btn-sm btn-ghost" bind:tap="uploadFile" data-kind="transcript">上传</view>
        </view>
      </view>

      <view class="btn btn-primary {{submitting ? 'btn-disabled' : ''}}" bind:tap="submit">
        {{submitting ? "提交中…" : (editing ? "保存修改" : "提交申请")}}
      </view>
      <view class="btn btn-plain" style="margin-top: 18rpx;" bind:tap="closeForm">取消</view>
    </view>
  </view>
</view>
