/**
 * 全局样式：设计 Token（浅色/深色双主题）+ 通用工具类
 * rpx 自适应（750rpx = 屏宽）；宽屏下阅读容器限宽
 */
page {
  /* 浅色主题（默认） */
  --brand: #1677ff;
  --brand-light: #e6f4ff;
  --brand-grad: #1677ff;
  --accent: #1677ff;
  --bg: #ffffff;
  --card: #ffffff;
  --card-2: #fafafa;
  --text: rgba(0, 0, 0, 0.88);
  --text-2: rgba(0, 0, 0, 0.45);
  --text-3: rgba(0, 0, 0, 0.25);
  --border: rgba(5, 5, 5, 0.06);
  --success: #52c41a;
  --warning: #faad14;
  --danger: #ff4d4f;
  --mask: rgba(0, 0, 0, 0.45);
  --shadow: none;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

@media (prefers-color-scheme: dark) {
  page {
    --brand: #1677ff;
    --brand-light: rgba(22, 119, 255, 0.18);
    --brand-grad: #1677ff;
    --bg: #141414;
    --card: #1f1f1f;
    --card-2: #262626;
    --text: rgba(255, 255, 255, 0.85);
    --text-2: rgba(255, 255, 255, 0.65);
    --text-3: rgba(255, 255, 255, 0.45);
    --border: rgba(253, 253, 253, 0.12);
    --shadow: none;
  }
}

/* ===== 布局 ===== */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.page-gray {
  background: var(--bg);
}

/* 宽屏（平板/折叠屏展开）阅读容器限宽居中 */
.readable {
  max-width: 700px;
  margin: 0 auto;
}

/* 小屏（≤360px，如 iPhone SE / 窄屏 Android）：收紧全局留白 */
@media (max-width: 360px) {
  .page {
    padding: 16rpx;
  }
  .card {
    padding: 22rpx;
    margin-bottom: 18rpx;
    border-radius: 12rpx;
  }
  .btn {
    height: 80rpx;
  }
  .form-item {
    margin-bottom: 22rpx;
  }
}

.card {
  background: var(--card);
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  box-sizing: border-box;
  border: 1rpx solid var(--border);
}

.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.wrap {
  flex-wrap: wrap;
}
.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 文本 ===== */
.h1 {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}
.h2 {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.h3 {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.text {
  font-size: 28rpx;
  color: var(--text);
}
.text-2 {
  font-size: 26rpx;
  color: var(--text-2);
}
.text-3 {
  font-size: 24rpx;
  color: var(--text-3);
}
.brand-text {
  color: var(--brand);
}
.bold {
  font-weight: 600;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.15s;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: var(--brand);
  color: #ffffff;
}
.btn-ghost {
  background: var(--brand-light);
  color: var(--brand);
}
.btn-plain {
  background: var(--card);
  color: var(--text);
  border: 1rpx solid var(--border);
}
.btn-danger {
  background: var(--danger);
  color: #ffffff;
}
.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}
.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: 6rpx;
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag-brand {
  background: var(--brand-light);
  color: var(--brand);
}
.tag-success {
  background: rgba(82, 196, 26, 0.12);
  color: var(--success);
}
.tag-warning {
  background: rgba(250, 173, 20, 0.12);
  color: var(--warning);
}
.tag-danger {
  background: rgba(255, 77, 79, 0.12);
  color: var(--danger);
}
.tag-gray {
  background: var(--card-2);
  color: var(--text-2);
  border: 1rpx solid var(--border);
}

/* ===== 表单 ===== */
.input {
  background: var(--card-2);
  border: 1rpx solid var(--border);
  border-radius: 6rpx;
  /* 不要用垂直 padding：微信原生 input 的行高与内容区叠加会导致上下裁字 */
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  width: 100%;
}
.textarea {
  background: var(--card-2);
  border: 1rpx solid var(--border);
  border-radius: 6rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text);
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
  display: block;
}

/* ===== 底部安全区 ===== */
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)) 24rpx;
  background: var(--card);
  border-top: 1rpx solid var(--border);
  z-index: 50;
}

/* ===== 分隔 ===== */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 骨架屏动画 */
@keyframes pulse {
  0% {
    opacity: 0.6;
  }
  50% {
    opacity: 0.3;
  }
  100% {
    opacity: 0.6;
  }
}
.skeleton {
  background: var(--card-2);
  border-radius: 6rpx;
  animation: pulse 1.4s ease-in-out infinite;
}
