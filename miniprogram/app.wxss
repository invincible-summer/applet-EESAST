/**
 * 全局样式：设计 Token（浅色/深色双主题）+ 通用工具类
 * rpx 自适应（750rpx = 屏宽）；宽屏下阅读容器限宽
 */
page {
  /* 浅色主题（默认） */
  --brand: #087f8c;
  --brand-dark: #075b65;
  --brand-light: #e5f6f7;
  --brand-grad: linear-gradient(135deg, #075b65 0%, #087f8c 54%, #16b8b2 100%);
  --accent: #f39b4a;
  --bg: #f3f8f8;
  --card: #ffffff;
  --card-2: #f7fbfb;
  --text: #122b33;
  --text-2: #557078;
  --text-3: #8ba0a5;
  --border: #dcebed;
  --success: #159b79;
  --warning: #d98a32;
  --danger: #d95858;
  --mask: rgba(17, 24, 39, 0.45);
  --shadow: 0 12rpx 36rpx rgba(28, 75, 82, 0.08);
  --shadow-hover: 0 16rpx 40rpx rgba(28, 75, 82, 0.14);

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

@media (prefers-color-scheme: dark) {
  page {
    --brand: #3cc6c3;
    --brand-dark: #b1f1ef;
    --brand-light: rgba(60, 198, 195, 0.14);
    --brand-grad: linear-gradient(135deg, #0c6670, #087f8c 55%, #18a6a3);
    --bg: #0d1d22;
    --card: #12282e;
    --card-2: #102329;
    --text: #e6f4f4;
    --text-2: #a1b9bd;
    --text-3: #6f8a90;
    --border: #24434a;
    --shadow: none;
    --shadow-hover: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
  }
}

/* ===== 布局 ===== */
.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
  box-sizing: border-box;
}
.page-gray {
  background: var(--bg);
}

page::before {
  content: "";
  position: fixed;
  z-index: -1;
  top: -180rpx;
  right: -160rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: rgba(22, 184, 178, 0.08);
}

/* 宽屏（平板/折叠屏展开）阅读容器限宽居中 */
.readable {
  max-width: 700px;
  margin: 0 auto;
}

/* 小屏（≤360px，如 iPhone SE / 窄屏 Android）：收紧全局留白 */
@media (max-width: 360px) {
  .page {
    padding: 16rpx;
  }
  .card {
    padding: 22rpx;
    margin-bottom: 18rpx;
    border-radius: 16rpx;
  }
  .btn {
    height: 80rpx;
  }
  .form-item {
    margin-bottom: 22rpx;
  }
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  box-sizing: border-box;
  border: 1rpx solid var(--border);
}

.card:active {
  box-shadow: var(--shadow-hover);
  transform: translateY(1rpx);
}

.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.wrap {
  flex-wrap: wrap;
}
.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 4rpx 4rpx 28rpx;
}
.page-title {
  display: block;
  margin-top: 6rpx;
}
.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

/* ===== 文本 ===== */
.h1 {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text);
}
.h2 {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.h3 {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.text {
  font-size: 28rpx;
  color: var(--text);
}
.text-2 {
  font-size: 26rpx;
  color: var(--text-2);
}
.text-3 {
  font-size: 24rpx;
  color: var(--text-3);
}
.brand-text {
  color: var(--brand);
}
.eyebrow {
  color: var(--brand);
  font-size: 21rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
}
.bold {
  font-weight: 600;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.15s;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: var(--brand-grad);
  color: #ffffff;
}
.btn-ghost {
  background: var(--brand-light);
  color: var(--brand);
}
.btn-plain {
  background: var(--card);
  color: var(--text);
  border: 1rpx solid var(--border);
}
.btn-danger {
  background: var(--danger);
  color: #ffffff;
}
.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}
.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag-brand {
  background: var(--brand-light);
  color: var(--brand);
}
.tag-success {
  background: rgba(16, 185, 129, 0.12);
  color: var(--success);
}
.tag-warning {
  background: rgba(245, 158, 11, 0.12);
  color: var(--warning);
}
.tag-danger {
  background: rgba(239, 68, 68, 0.12);
  color: var(--danger);
}
.tag-gray {
  background: var(--card-2);
  color: var(--text-2);
  border: 1rpx solid var(--border);
}

/* ===== 表单 ===== */
.input {
  background: var(--card-2);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  width: 100%;
}
.textarea {
  background: var(--card-2);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
  display: block;
}

/* ===== 底部安全区 ===== */
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)) 24rpx;
  background: var(--card);
  border-top: 1rpx solid var(--border);
  z-index: 50;
}

/* ===== 分隔 ===== */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 骨架屏动画 */
@keyframes pulse {
  0% {
    opacity: 0.6;
  }
  50% {
    opacity: 0.3;
  }
  100% {
    opacity: 0.6;
  }
}
.skeleton {
  background: var(--card-2);
  border-radius: 12rpx;
  animation: pulse 1.4s ease-in-out infinite;
}
